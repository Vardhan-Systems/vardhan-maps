{
  "name": "vardhan-maps",
  "version": "0.13.0",
  "description": "Standard India map built on OpenStreetMap: state + district boundaries (aligned to the official Government of India depiction) as GeoJSON, dependency-free SVG + Leaflet/React renderers, and an optional self-hosted light-grey vector basemap (roads + labels, no POI) that works out of the box.",
  "license": "MIT",
  "author": "Vardhan Systems",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "ATTRIBUTION.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "import": "./dist/svg/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "import": "./dist/react-native/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node scripts/fetch-osm.mjs",
    "data:overrides": "node scripts/make-goi-overrides.mjs",
    "data:build": "node scripts/build-data.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@maplibre/maplibre-gl-leaflet": ">=0.0.19",
    "@maplibre/maplibre-react-native": ">=10",
    "leaflet": ">=1.9",
    "maplibre-gl": ">=3 <5",
    "pmtiles": ">=3",
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "@maplibre/maplibre-react-native": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "@maplibre/maplibre-gl-leaflet": {
      "optional": true
    },
    "pmtiles": {
      "optional": true
    }
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@maplibre/maplibre-react-native": "^11.3.10",
    "@types/geojson": "^7946.0.14",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.8.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "pmtiles": "^4.5.0",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-native": "0.86.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "india",
    "map",
    "india-map",
    "geojson",
    "boundaries",
    "states",
    "districts",
    "openstreetmap",
    "osm",
    "leaflet",
    "maplibre",
    "maplibre-gl",
    "pmtiles",
    "vector-tiles",
    "basemap",
    "react",
    "svg",
    "choropleth",
    "telangana",
    "andhra-pradesh"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vardhansystems/vardhan-maps.git"
  },
  "homepage": "https://github.com/vardhansystems/vardhan-maps#readme",
  "publishConfig": {
    "access": "public"
  }
}
